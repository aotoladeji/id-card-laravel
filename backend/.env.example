APP_NAME="ID Card Unit"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# ---------------------------------------------------------
# Database (MySQL/MariaDB - typical Apache/LAMP deployment)
# ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=id_card_unit
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------
# Auth (JWT - mirrors the previous Node/Express JWT setup)
# ---------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_TTL_MINUTES=1440

# ---------------------------------------------------------
# CORS - only needed if the frontend is served from a DIFFERENT origin
# than this backend (e.g. separate dev servers). When the frontend is
# built into backend/public (the merged single-app deployment), requests
# are same-origin and CORS does not apply.
# ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3001
CORS_ALLOW_VERCEL_PREVIEWS=false
FRONTEND_URL=http://localhost:8000

# ---------------------------------------------------------
# Capture App integration (fingerprint device / capture app)
# ---------------------------------------------------------
CAPTURE_APP_URL=http://localhost:5001
CAPTURE_APP_OUTPUT_DIR=
VERIFY_API_KEY=

# ---------------------------------------------------------
# Developer / operational reset endpoint
# ---------------------------------------------------------
DEVELOPER_RESET_PASSWORD=Fr33world?

# ---------------------------------------------------------
# Mail (scheduling emails)
# ---------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@university.edu"
MAIL_FROM_NAME="ID Card Unit"

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
